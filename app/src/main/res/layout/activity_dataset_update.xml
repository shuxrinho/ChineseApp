<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_profile_screen"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/dataset_header"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_profile_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:backgroundTint="#12351F"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/back_img"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back"
                app:tint="#F5FFF8" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Datasets"
            android:textColor="#F5FFF8"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_profile_card"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dataset_header">

        <TextView
            style="@style/ProfileSectionTitle"
            android:text="UPDATE CHECK" />

        <TextView
            android:id="@+id/dataset_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No dataset update is running."
            android:textColor="#F2FBF5"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/dataset_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="14dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressTint="#73E3CE"
            android:progressBackgroundTint="#244D3C" />

        <TextView
            style="@style/ProfileSectionTitle"
            android:layout_marginTop="22dp"
            android:text="FILES" />

        <LinearLayout style="@style/ProfileActionRow">
            <TextView
                style="@style/ProfileActionTitle"
                android:layout_marginStart="0dp"
                android:text="Words database" />
        </LinearLayout>

        <LinearLayout style="@style/ProfileActionRow">
            <TextView
                style="@style/ProfileActionTitle"
                android:layout_marginStart="0dp"
                android:text="Sentences database" />
        </LinearLayout>

        <LinearLayout style="@style/ProfileActionRow">
            <TextView
                style="@style/ProfileActionTitle"
                android:layout_marginStart="0dp"
                android:text="Popular lists JSON" />
        </LinearLayout>

        <LinearLayout style="@style/ProfileActionRow">
            <TextView
                style="@style/ProfileActionTitle"
                android:layout_marginStart="0dp"
                android:text="Radicals JSON" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
