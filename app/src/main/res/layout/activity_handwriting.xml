<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".HandwritingActivity"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="5dp">
        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:cardCornerRadius="10dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/primary"
            android:elevation="10dp">
            <ImageView
                android:id="@+id/back_img"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_back"
                android:layout_gravity="center"/>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            app:cardCornerRadius="10dp"
            android:layout_margin="10dp"
            android:backgroundTint="@color/primary"
            android:elevation="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Handwriting Practice"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:paddingVertical="5dp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    android:elevation="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:src="@drawable/radical_write"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Radicals Practice"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="Master the building blocks."
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>

                        <com.example.chineseapp.Helpers.CustomButton
                            android:id="@+id/radicals_practice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/rounded_corners_shape"
                            android:backgroundTint="#2196F3"
                            android:layout_marginHorizontal="10dp"
                            android:clickable="true"
                            android:focusable="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="START PRACTICE"
                                android:textSize="14sp"
                                android:textColor="#fff"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginHorizontal="8dp"
                                android:layout_marginVertical="5dp"/>
                        </com.example.chineseapp.Helpers.CustomButton>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Repeat same pattern for the other 3 cards -->
                <!-- Just change: background color, large character, title, description, button tint -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:src="@drawable/hanzi_write"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hanzi Practice"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="Write complete characters."
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>
                        <com.example.chineseapp.Helpers.CustomButton
                            android:id="@+id/hanzi_practice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginHorizontal="10dp"
                            android:clickable="true"
                            android:background="@drawable/rounded_corners_shape"
                            android:backgroundTint="#4CAF50"
                            android:focusable="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="START PRACTICE"
                                android:textSize="14sp"
                                android:textColor="#fff"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginHorizontal="8dp"
                                android:layout_marginVertical="5dp"/>
                        </com.example.chineseapp.Helpers.CustomButton>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:src="@drawable/structure_write"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Word Structure practice"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="Fill the missing parts of words."
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>
                        <com.example.chineseapp.Helpers.CustomButton
                            android:id="@+id/structures_practice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginHorizontal="10dp"
                            android:clickable="true"
                            android:background="@drawable/rounded_corners_shape"
                            android:backgroundTint="#FF9800"
                            android:focusable="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="START PRACTICE"
                                android:textSize="14sp"
                                android:textColor="#fff"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginHorizontal="8dp"
                                android:layout_marginVertical="5dp"/>
                        </com.example.chineseapp.Helpers.CustomButton>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Repeat same pattern for the other 3 cards -->
                <!-- Just change: background color, large character, title, description, button tint -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="130dp"
                            android:layout_height="130dp"
                            android:src="@drawable/list_write"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Word List Practice"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="Practice set of words."
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>
                        <com.example.chineseapp.Helpers.CustomButton
                            android:id="@+id/word_list_practice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginHorizontal="10dp"
                            android:clickable="true"
                            android:background="@drawable/rounded_corners_shape"
                            android:backgroundTint="#9C27B0"
                            android:focusable="true">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="START PRACTICE"
                                android:textSize="14sp"
                                android:textColor="#fff"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginHorizontal="8dp"
                                android:layout_marginVertical="5dp"/>
                        </com.example.chineseapp.Helpers.CustomButton>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>