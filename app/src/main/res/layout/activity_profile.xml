<?xml version="1.0" encoding="utf-8"?>
<com.example.chineseapp.Helpers.PullSyncContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pull_sync"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_profile_screen"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/profile_header"
            android:layout_width="0dp"
            android:layout_height="168dp"
            android:background="@drawable/bg_profile_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/profile_avatar_frame"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_profile_avatar_frame"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/profile_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:contentDescription="Profile photo"
                    android:src="@drawable/ic_default_profile"
                    app:tint="#07120A" />

                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_profile_camera_badge"
                    android:padding="7dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_camera_line"
                        app:tint="#DDFBE8" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Shuxrat"
                    android:textColor="#F5FFF8"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="shuxrateshm10@gmail.com"
                    android:textColor="#DFF4E7"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/profile_email_not_confirmed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Profile not authenticated. Please confirm your email."
                    android:textColor="#FFB74D"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/profile_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="14dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/log_out"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_header">

            <androidx.cardview.widget.CardView
                android:id="@+id/profile_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#00000000"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/profile_actions_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:text="PROFILE" />

                    <LinearLayout
                        android:id="@+id/change_pfp_btn"
                        style="@style/ProfileActionRow">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_camera_line" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Change Profile Photo" />

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/change_username_btn"
                        style="@style/ProfileActionRow"
                        android:minHeight="68dp">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_username" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/ProfileActionTitle"
                                android:layout_width="match_parent"
                                android:layout_marginStart="0dp"
                                android:layout_weight="0"
                                android:text="Change Username" />

                            <TextView
                                android:id="@+id/username_secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="shuxrateshm10"
                                android:textColor="#F4D86A"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="SOCIAL" />

                    <LinearLayout
                        android:id="@+id/row_friends"
                        style="@style/ProfileActionRow"
                        android:layout_marginTop="10dp">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_people" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Friends" />

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/row_followers"
                        style="@style/ProfileActionRow">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_person_add" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Followers" />

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="APP PREFERENCES" />

                    <LinearLayout
                        android:id="@+id/change_notification_btn"
                        style="@style/ProfileActionRow"
                        android:layout_marginTop="10dp">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_notifications" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Notifications" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_notifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/set_goals"
                        style="@style/ProfileActionRow">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_goal" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Daily Goal" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_goals"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/check_datasets_btn"
                        style="@style/ProfileActionRow">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_tune" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Check datasets" />

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="ACCOUNT" />

                    <LinearLayout
                        android:id="@+id/change_email_btn"
                        style="@style/ProfileActionRow"
                        android:layout_marginTop="10dp"
                        android:minHeight="68dp">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_email" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/ProfileActionTitle"
                                android:layout_width="match_parent"
                                android:layout_marginStart="0dp"
                                android:layout_weight="0"
                                android:text="Email Address" />

                            <TextView
                                android:id="@+id/email_secondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="shuxrateshm10@gmail.com"
                                android:textColor="#BAD2C5"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:layout_marginTop="18dp"
                        android:text="SECURITY" />

                    <LinearLayout
                        android:id="@+id/row_security_settings"
                        style="@style/ProfileActionRow"
                        android:layout_marginTop="10dp">

                        <ImageView
                            style="@style/ProfileActionIcon"
                            android:src="@drawable/ic_shield_lock" />

                        <TextView
                            style="@style/ProfileActionTitle"
                            android:text="Security Settings" />

                        <ImageView
                            style="@style/ProfileActionChevron"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/log_out"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_profile_logout_button"
            android:elevation="6dp"
            android:text="Log out"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_go"
            app:iconGravity="textEnd"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.example.chineseapp.Helpers.PullSyncContainer>
